#&--------------------------------------------------< 9      CLASS ORDERITEM       >--------------------------------------------------
class OrderItem:
    def __init__(self, product: Product, quantity: int):
        if quantity <= 0:
            raise ValueError("Quantity must be greater than 0")

        self.order_item_id = functions.id_generator()
        self.product_id = product.product_id
        self.product_name = product.product_name
        self.brand = product.brand
        self.unit_price = product.price
        self.quantity = quantity
        self.total_price = self.unit_price * self.quantity

    def update_quantity(self, new_quantity: int):
        if new_quantity <= 0:
            raise ValueError("Quantity must be greater than 0")

        self.quantity = new_quantity
        self.total_price = self.unit_price * self.quantity

    def to_dict(self):
        return {
            "order_item_id": self.order_item_id,
            "product_id": self.product_id,
            "product_name": self.product_name,
            "brand": self.brand,
            "unit_price": self.unit_price,
            "quantity": self.quantity,
            "total_price": self.total_price
        }

    def __str__(self):
        return (
            f"{self.product_name} ({self.brand}) | "
            f"{self.quantity} x {self.unit_price} = {self.total_price}"
        )


#&--------------------------------------------------< 9        CLASS ORDER         >--------------------------------------------------
class Order:

    def __init__(self, customer: Customer, seller: Seller):
        self.order_id = functions.id_number_generator()
        self.customer = customer
        self.seller = seller
        self.items: list[OrderItem]= []
        self.order_date = datetime.now()
        self.status = data.order_status
        self.shipping_address = customer.address
        self.total_price = 0.0
        self.payment_status = str


    # ---------- Customer ----------
    @property
    def customer(self) -> "Customer":
        return self._customer

    @customer.setter
    def customer(self, value: "Customer"):
        if value is None:
            raise ValueError("customer cannot be None")
        if not hasattr(value, "address"):
            raise TypeError("customer must have an address attribute")
        self._customer = value

    # ---------- Seller ----------
    @property
    def seller(self) -> "Seller":
        return self._seller

    @seller.setter
    def seller(self, value: "Seller"):
        if value is None:
            raise ValueError("seller cannot be None")
        self._seller = value

    # ---------- Items ----------
    @property
    def items(self) -> list["OrderItem"]:
        return self._items

    @items.setter
    def items(self, value: list):
        if not isinstance(value, list):
            raise TypeError("items must be a list")
        for item in value:
            self._validate_order_item(item)
        self._items = value
        self._recalculate_total()

    # ---------- Order Date ----------
    @property
    def order_date(self) -> datetime:
        return self._order_date

    @order_date.setter
    def order_date(self, value: datetime):
        if not isinstance(value, datetime):
            raise TypeError("order_date must be a datetime object")
        self._order_date = value

    # ---------- Status ----------
    @property
    def status(self):
        return self._status

    @status.setter
    def status(self, value):
        if value not in data.order_status:
            raise ValueError(f"Invalid order status: {value}")
        self._status = value

    # ---------- Shipping Address ----------
    @property
    def shipping_address(self) -> str:
        return self._shipping_address

    @shipping_address.setter
    def shipping_address(self, value: str):
        if not isinstance(value, str):
            raise TypeError("shipping_address must be a string")
        if not value.strip():
            raise ValueError("shipping_address cannot be empty")
        self._shipping_address = value

    # ---------- Total Price (read-only) ----------
    @property
    def total_price(self) -> float:
        return self.total_price


    @property
    def payment_status(self):
        return self.payment_status
    @payment_status.setter
    def payment_status(self, value):
        if value in data.order_payment_status:
            print(colorama.Fore.CYAN + f"the order payment set to {value}")
            self.payment_status = value
        else:
            print(colorama.Fore.YELLOW + "invalid payment status")


            
