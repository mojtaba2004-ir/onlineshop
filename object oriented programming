#&--------------------------------------------------< 5        CLASS HUMAN         >--------------------------------------------------
class Human:
    def __init__(self):
        self._first_name = ""
        self._last_name = ""
        self._age = 0
        self._gender = ""
        self._phone = ""
        self._address = ""
        self._email = ""


    @property
    def first_name(self):
        return self._first_name
    @first_name.setter
    def first_name(self, value):
        if value == "":
            print(colorama.Fore.YELLOW + "Name cannot be empty.")
        elif not str(value).isalpha():
            print(colorama.Fore.YELLOW + "The name must contain only alphabetic characters.")
        elif len(value) < 2:
            print(colorama.Fore.YELLOW + "Name must be at least 2 characters long.")
        else:
            print(colorama.Fore.GREEN + f"Name set to {value}.")
            self._first_name = value

    @property
    def last_name(self):
        return self._last_name
    @last_name.setter
    def last_name(self, value):
        if value == "":
            print(colorama.Fore.YELLOW + "Name cannot be empty.")
        elif not value.isalpha():
            print(colorama.Fore.YELLOW + "The name must contain only alphabetic characters.")
        elif len(value) < 2:
            print(colorama.Fore.YELLOW + "Name must be at least 2 characters long.")
        else:
            print(colorama.Fore.GREEN + f"Name set to {value}.")
            self._last_name = value

    @property
    def age(self):
        return self._age
    @age.setter
    def age(self, value):
        if not isinstance(value, int):
            print(colorama.Fore.YELLOW + "Enter numeric age.")
            return

        if value == 0:
            print(colorama.Fore.YELLOW + "Age cannot be zero.")
        elif value < 18:
            print(colorama.Fore.YELLOW + "Age under 18 is illegal.")
        elif value > 100:
            print(colorama.Fore.YELLOW + "Age cannot be greater than 100.")
        else:
            print(colorama.Fore.GREEN + f"age set to {value}")
            self._age = value

    @property
    def gender(self):
        return self._gender
    @gender.setter
    def gender(self, value):
        if value in data.valid_genders:
            print(colorama.Fore.GREEN + f"gender set to{value}")
            self._gender = value
        else:
            print(colorama.Fore.YELLOW + f"the gender must be {data.valid_genders}")

    @property
    def phone(self):
        return self._phone

    @phone.setter
    def phone(self, value):
        pattern = r"^(098|\+98)\d{10}$"

        if not isinstance(value, str) or not value.strip():
            raise ValueError("Phone number must be a non-empty string.")

        if not re.match(pattern, value):
            raise ValueError("Phone number must start with '098' or '+98' followed by exactly 10 digits.")

        print(colorama.Fore.GREEN + f"phone number set to {value}.")
        self._phone = value  # Set only after validation passes


    @property
    def address(self):
        return self._address
    @address.setter
    def address(self, value):
        if not isinstance(value, str):
            print(colorama.Fore.YELLOW + "address must be a string.")
            return

        if value.strip() == "":
            print(colorama.Fore.YELLOW + "address cannot be empty.")
            return

        if len(value.strip()) < 5:
            print(colorama.Fore.YELLOW + "address is too short. enter at least 5 characters.")
            return

        pattern = r"^[a-zA-Z0-9\s,.\-#]+$"
        if not re.match(pattern, value):
            print(colorama.Fore.YELLOW + "address contains invalid characters.")
            return

        self._address = value.strip()
        print(colorama.Fore.GREEN + f"address set to: {self._address}")

    @property
    def email(self):
        return self._email
    @email.setter
    def email(self, value):
        pattern = r'^[\w\.-]+@[\w\.-]+\.\w+$'
        if not isinstance(value, str):
            print(colorama.Fore.YELLOW + "email must be a string.")
        
        elif value.strip() == "":
            print(colorama.Fore.YELLOW + "email cannot be empty.")        
        
        elif not re.match(pattern, value):
            print(colorama.Fore.YELLOW + "invalid email format.")
            return
        
        else:
            print(colorama.Fore.GREEN + f"email set to '{value}'.")
            self._email = value


