class Seller(Human):
    def __init__(self):
        super().__init__()
        self._seller_id = ""
        self._store_name = ""
        self._plaque_store = ""
        self._business_license = ""
        self._login_time = datetime.now()  # Added login_time field

    @property
    def seller_id(self):
        return self._seller_id  # Fixed: return the private attribute

    @seller_id.setter
    def seller_id(self, value):
        self._seller_id = value  # Fixed: set the private attribute

    @property
    def store_name(self):
        return self._store_name

    @store_name.setter
    def store_name(self, value):
        pattern = r"^[a-zA-Z0-9 &\-\']+$"
        if not isinstance(value, str):
            print(colorama.Fore.YELLOW + "store name must be a string.")
        elif len(value.strip()) == 0:
            print(colorama.Fore.YELLOW + "store name cannot be empty.")
        elif len(value) < 3:
            print(colorama.Fore.YELLOW + "store name must be at least 3 characters long.")
            return
        elif not re.match(pattern, value):
            print(colorama.Fore.YELLOW + "Store name contains invalid characters.[letters, numbers, spaces, &, -, ']")
        else:
            print(colorama.Fore.GREEN + f"Store name set to '{value}'.")
            self._store_name = value

    @property
    def plaque_store(self):
        return self._plaque_store

    @plaque_store.setter
    def plaque_store(self, value):
        if not isinstance(value, str):
            print(colorama.Fore.YELLOW + "plaque store must be a string.")
            return
        if value.strip() == "":
            print(colorama.Fore.YELLOW + "plaque store cannot be empty.")
            return
        if len(value) < 2:
            print(colorama.Fore.YELLOW + "plaque store must be at least 2 characters long.")
            return
        if not re.match(r"^[A-Za-z]+", value):
            print(colorama.Fore.YELLOW + "plaque store must start with letters.")
            return
        if not value[-1].isdigit():
            print(colorama.Fore.YELLOW + "plaque store must end with a number.")
            return
        print(colorama.Fore.GREEN + f"plaque store set to '{value}'.")
        self._plaque_store = value

    @property
    def business_license(self):
        return self._business_license

    @business_license.setter
    def business_license(self, value):
        pattern = r"^1404[A-Za-z0-9]{6,25}$"
        if not isinstance(value, str):
            raise ValueError("Business license must be a string.")
        elif value.strip() == "":
            raise ValueError("Business license cannot be empty.")
        elif not re.match(pattern, value):
            raise ValueError("Invalid business license format. Must start with '1404' and be followed by 9-25 letters/digits.")
        else:
            self._business_license = value

    @property
    def login_time(self):
        return self._login_time  # Added getter for login_time

    @login_time.setter
    def login_time(self, value):
        from datetime import datetime
        if value is not None and not isinstance(value, datetime):
            raise ValueError("login_time must be a datetime object or None")
        self._login_time = value  # Added setter for login_time


