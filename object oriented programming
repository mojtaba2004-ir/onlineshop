        if value == "":
            print(colorama.Fore.YELLOW + "product name cannot be empty.")
        elif len(value) < 2:
            print(colorama.Fore.YELLOW + "the length of product name can not be smaller than 2.")
        elif isinstance(value, str) and len(value) >= 3:
