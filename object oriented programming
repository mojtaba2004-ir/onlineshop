            print(colorama.Fore.YELLOW + "ERROR: enter a valid camera megapixels[32, 48, 64, 108...]")


    @property
    def quantity(self):
        return self._quantity
    @quantity.setter
    def quantity(self, value):
        if value == "":
            print(colorama.Fore.YELLOW + "quantity cannot be empty.")
        elif not str(value).isdigit():
            print(colorama.Fore.YELLOW + "quantity must be a number.")
        elif int(value) <= 0:
            print(colorama.Fore.YELLOW + "quantity must be greater than 0.")
        else:
            self._quantity = int(value)


    @property
    def purchased_quantity(self):
