    def date_of_birth(self, value):
        if isinstance(value, date):
            self._date_of_birth = value
        elif isinstance(value, str):
            # Try to convert string to date
            try:
                self._date_of_birth = datetime.strptime(value, "%Y-%m-%d").date()
            except ValueError:
                raise ValueError("date_of_birth must be a date object or a string in 'YYYY-MM-DD' format")
        elif value is None:
            self._date_of_birth = None
        else:
            raise TypeError("date_of_birth must be a datetime.date or string")



    @property
    def login_time(self):
        return self._login_time

    @login_time.setter
    def login_time(self, value):
        from datetime import datetime
        if value is not None and not isinstance(value, datetime):
            raise ValueError("login_time must be a datetime object or None")
        self._login_time = value


