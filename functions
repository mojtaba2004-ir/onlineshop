        Panel(
            table,
            title=f"[bold green]Total: ${total:.2f}[/bold green]",
            border_style="green"
        )
    )

    return total


def process_bank_payment(cur, total):

    transaction_log = []

    def generate_trn_id():
        return "TRN-" + "".join(
            random.choices(
                string.ascii_uppercase + string.digits,
                k=10
            )
        )

    def valid_name(name):
        pattern = r"^[A-Za-z\s\.\-]+$"
        return bool(name and re.fullmatch(pattern, name.strip()))

    def valid_account(num):
        return num.isdigit() and 10 <= len(num) <= 16

    def ask(prompt, validator, error):
        while True:
            value = questionary.text(prompt).ask()
            if validator(value):
                return value.strip()
            console.print(f"[red]{error}[/red]")

    try:

        bank_name = ask(
            "[cyan]Enter bank name:[/cyan]",
            valid_name,
            "Invalid bank name"
        )

        account_holder = ask(
            "[cyan]Enter account holder name:[/cyan]",
            valid_name,
            "Invalid name"
        )

        account_number = ask(
            "[cyan]Enter account number:[/cyan]",
            valid_account,
            "Account must be 10–16 digits"
        )

        trn_id = generate_trn_id()

        payment = total
        change = 0

        masked_account = "****" + account_number[-4:]

        transaction_log.append({
            "trn_id": trn_id,
            "bank": bank_name,
            "account_holder": account_holder,
            "account_number": masked_account,
            "amount": payment
        })

        console.print(
            Panel(
                f"[green]Payment Successful[/green]\n\n"
                f"Transaction ID: {trn_id}\n"
                f"Bank: {bank_name}\n"
                f"Account Holder: {account_holder}\n"
                f"Account Number: {masked_account}\n"
                f"Amount Charged: ${total:.2f}",
                title="BANK PAYMENT RECEIPT",
                border_style="green"
            )
        )

        return {
            "payment": payment,
            "change": change,
            "transaction_id": trn_id,
            "log": transaction_log
        }

    except Exception as e:
        console.print(f"[red]Payment failed: {str(e)}[/red]")
        return None


