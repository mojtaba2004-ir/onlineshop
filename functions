def edit_product(conn=None, logged_seller=None):

    while True:

        choice = questionary.select(
            "Choose product type:",
            choices=["1. PHONE", "2. CAMERA", "3. LAPTOP", "4. EXIT"]
        ).ask()

        if choice == "4. EXIT":
            return

        if not logged_seller:
            show_error("You must be logged in")
            return

        product_id = input(Fore.BLUE + "Enter product ID >> ").strip()

        if not product_id:
            show_error("Product ID required")
            continue

        db_conn = connect_database(
            'root',
            'MY$sql2025',
            'localhost',
            3306,
            'onlineshop'
        )

        if not db_conn:
            show_error("Database connection failed")
            continue

        cursor = db_conn.cursor(dictionary=True)

        try:

            cursor.execute("""
                SELECT *
                FROM product
                WHERE product_id=%s
            """, (product_id,))

            product = cursor.fetchone()

            if not product:
                show_error("Product not found")
                continue

            fields = ["product_name", "brand", "price", "colour", "weight", "quantity"]
            updates = {}

            for field in fields:

                old = product[field]

                value = input(f"{field} [{old}] >> ").strip()

                if value == "":
                    continue

                try:
                    if field in ["price", "weight"]:
                        value = float(value)
                    elif field == "quantity":
                        value = int(value)
                    else:
                        value = value.upper()

                    updates[field] = value

                except:
                    show_error(f"Invalid {field}")

            if updates:
                sql = "UPDATE product SET " + ",".join(f"{k}=%s" for k in updates) + " WHERE product_id=%s"
                cursor.execute(sql, list(updates.values()) + [product_id])

            # ===== SPEC UPDATE =====
            cursor.execute("""
                SELECT *
                FROM product_spec
                WHERE product_id=%s
            """, (product_id,))

            specs = cursor.fetchall()

            for spec in specs:

                key = spec["spec_key"]
                old = spec["spec_value"]

                value = input(f"{key} [{old}] >> ").strip()

                if value == "":
                    continue

                # normalize yes/no
                if isinstance(value, str):
                    if value.lower() == "yes":
                        value = 1
                    elif value.lower() == "no":
                        value = 0

                cursor.execute("""
                    UPDATE product_spec
                    SET spec_value=%s
                    WHERE product_id=%s AND spec_key=%s
                """, (str(value), product_id, key))

            db_conn.commit()

            show_success("Product updated successfully")

        except Exception as e:
            db_conn.rollback()
            show_error(str(e))

        finally:
            cursor.close()
            db_conn.close()


def show_products(conn=None, logged_seller=None):

    def fetch_specs(cursor, product_id):
        cursor.execute("""
            SELECT spec_key, spec_value
            FROM product_spec
            WHERE product_id=%s
        """, (product_id,))

        return {row["spec_key"]: row["spec_value"] for row in cursor.fetchall()}

    while True:

        choice = questionary.select(
            "Select product type to display:",
            choices=["1. PHONE", "2. CAMERA", "3. LAPTOP", "4. ALL PRODUCTS", "5. EXIT"]
        ).ask()

        if choice == "5. EXIT":
            return

        conn = connect_database(
            'root',
            'MY$sql2025',
            'localhost',
            3306,
            'onlineshop'
        )

        if not conn:
            show_error("Database connection failed")
            return

        cursor = conn.cursor(dictionary=True)

        try:

            product_type = {
                "1. PHONE": "phone",
                "2. CAMERA": "camera",
                "3. LAPTOP": "laptop"
            }.get(choice)

            if product_type:
                cursor.execute("SELECT * FROM product WHERE product_type=%s", (product_type,))
            else:
                cursor.execute("SELECT * FROM product")

            products = cursor.fetchall()

            if not products:
                show_error("No products found")
                continue

            for product in products:

                specs = fetch_specs(cursor, product["product_id"])

                table = Table(
                    title=f"{product['product_type'].upper()} PRODUCT",
                    border_style="cyan"
                )

                table.add_column("Field", style="yellow")
                table.add_column("Value")

                fields = {
                    "ID": product.get("product_id"),
                    "Name": product.get("product_name"),
                    "Brand": product.get("brand"),
                    "Price": product.get("price"),
                    "Color": product.get("colour"),
                    "Weight": product.get("weight"),
                    "Quantity": product.get("quantity"),
                    "Purchased": product.get("purchased_quantity"),
                    "Type": product.get("product_type"),
                }

                fields.update(specs)

                for k, v in fields.items():

                    if v is None or v == "":
                        v = "-"

                    table.add_row(str(k).replace("_", " ").title(), str(v))

                console.print(table)

        except Exception as e:
            show_error(f"Error fetching products: {e}")

        finally:
            cursor.close()


