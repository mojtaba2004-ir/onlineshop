#^++++++++++++++++++++++++++++++++++++++++++++++++++ SPINNING  FUNCTIONS +++++++++++++++++++++++++++++++++++++++++++++++++++++
#?++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
def spinning(total_time_seconds):
    #'-', '/', '|', '\\'
    percent_list = [f"{i}%" for i in range(101)]
    spinner = itertools.cycle(percent_list)
    start_time = time.time()

    while (time.time() - start_time) < total_time_seconds:
        sys.stdout.write(f"\r{colorama.Fore.LIGHTMAGENTA_EX}PLEASE WAIT FOR A MOMENT. {next(spinner)}")
        sys.stdout.flush()
        time.sleep(0.2)

    sys.stdout.write("\r" + " " * 50 + "\r")    #   **   it clears the lines   **
    sys.stdout.flush()


