            console.print("[red]No database connection provided.[/red]")
            return False

        if not logged_user:
            console.print("[red]You must be logged in to edit your profile.[/red]")
            return False

        # Get seller_id safely from property
        customer_id = getattr(logged_user, "customer_id", None)
        if customer_id in (None, "", 0):
            console.print("[red]Could not determine customer ID.[/red]")
            return False

        # Fields that can be updated, mapped to property names
        allowed_fields = {
            "first_name": "First Name",
            "last_name": "Last Name",
            "age": "Age",
            "gender": "Gender",
            "phone": "Phone",
            "address": "Address",
            "email": "Email",
            "date_of_birth": "Date of birth"
        }

        # Collect new values from the user
        filtered_updates = {}
        for field, prompt_text in allowed_fields.items():
            # Use the property to get current value
            current_value = getattr(logged_user, field, "")
            new_value = input(f"{prompt_text} [{current_value}]: ").strip()
            if new_value and new_value != str(current_value):
                filtered_updates[field] = new_value

        if not filtered_updates:
            console.print("[yellow]No changes made to the profile.[/yellow]")
            return False


        set_clause = ", ".join(f"{field} = %s" for field in filtered_updates)
        values = list(filtered_updates.values())
        values.append(customer_id)  # For WHERE clause

        query = f"UPDATE customer SET {set_clause} WHERE customer_id = %s"

        cursor = conn.cursor()
        cursor.execute(query, tuple(values))
        conn.commit()
        cursor.close()

        console.print(Panel("[green]Profile updated successfully![/green]", title="Success", border_style="green"))

        for field, value in filtered_updates.items():
            setattr(logged_user, field, value)

        return True

    except mysql.connector.Error as e:
        console.print(Panel(f"[red]Database error: {e}[/red]", title="Error", border_style="red"))
        return False
    except Exception as e:
        console.print(Panel(f"[red]Unexpected error: {e}[/red]", title="Error", border_style="red"))
