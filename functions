    db_conn = connect_database('root', 'MY$sql2025', 'localhost', 3306, 'onlineshop')
    if not db_conn:
        return
    

    # Step 3: Check if customer exists
    cursor = db_conn.cursor(dictionary=True)
    cursor.execute("SELECT * FROM customer WHERE customer_id = %s", (id_number,))
    row = cursor.fetchone()
    cursor.close()

    if not row:
        console.print(f"No customer found with ID '{id_number}'.", style="bold red")
        db_conn.close()
        return

    # Step 4: Create customer object and load data using properties
    customer = Customer()
    try:
        customer.customer_id = row['id_number']  # assuming _id_number is private to avoid setter side effects
        customer.first_name = row['first_name']
        customer.last_name = row['last_name']
        customer.age = row['age']
        customer.gender = row['gender']
        customer.phone = row['phone']
        customer.address = row['address']
        customer.email = row['email']
        customer.date_of_birth = row['date_of_birth']
    except Exception as e:
        console.print(f"Error loading customer data: {e}", style="bold red")
        db_conn.close()
        return

    # Helper function for interactive property editing
    def prompt_property(prop_name, current_value, valid_options=None):
        while True:
            prompt = f"Enter {prop_name} [{current_value}] >> "
            val = input(colorama.Fore.BLUE + prompt).strip()
            if val == "":
                return current_value
            if valid_options and val.capitalize() not in valid_options:
                print(colorama.Fore.YELLOW + f"Invalid {prop_name}. Choose from: {', '.join(valid_options)}")
                continue
            try:
                setattr(customer, prop_name, val)
                return getattr(customer, prop_name)
            except Exception as e:
                print(colorama.Fore.YELLOW + f"Invalid {prop_name}: {e}")

    # Step 5: Interactive editing using properties
    customer.first_name = prompt_property("first_name", customer.first_name)
    customer.last_name = prompt_property("last_name", customer.last_name)

    while True:
        age_input = input(colorama.Fore.BLUE + f"Enter age [{customer.age}] >> ").strip()
        if age_input == "":
            age_val = customer.age
            break
        try:
            customer.age = int(age_input)
            age_val = customer.age
            break
        except Exception as e:
            print(colorama.Fore.YELLOW + f"Invalid age: {e}")
    customer.age = age_val

    customer.gender = prompt_property("gender", customer.gender, valid_options=['Male', 'Female', 'Other'])
    customer.phone = prompt_property("phone", customer.phone)
    customer.address = prompt_property("address", customer.address)
    customer.email = prompt_property("email", customer.email)

    while True:
        dob_input = input(colorama.Fore.BLUE + f"Enter date_of_birth [{customer.date_of_birth}] (YYYY-MM-DD) >> ").strip()
        if dob_input == "":
            dob_val = customer.date_of_birth
            break
        try:
            dob_dt = datetime.strptime(dob_input, '%Y-%m-%d').date()
            customer.date_of_birth = dob_dt
            dob_val = customer.date_of_birth
            break
        except Exception as e:
            print(colorama.Fore.YELLOW + f"Invalid date_of_birth: {e}")
    customer.date_of_birth = dob_val

    # Step 6: Update database record
    try:
        cursor = db_conn.cursor()
        sql = """
            UPDATE customer
            SET first_name=%s, last_name=%s, age=%s, gender=%s, phone=%s,
                address=%s, email=%s, date_of_birth=%s
            WHERE id_number=%s
        """
        cursor.execute(sql, (
            customer.first_name, customer.last_name, customer.age, customer.gender,
            customer.phone, customer.address, customer.email, customer.date_of_birth,
            customer._id_number
        ))
        db_conn.commit()
        console.print(f"Customer with ID '{customer._id_number}' updated successfully!", style="bold green")
        cursor.close()
    except Exception as e:
        console.print(f"Failed to update customer details: {e}", style="bold red")
    finally:
        db_conn.close()


