def show_order(conn, logged_user):
    console = Console()
    try:
        if not conn:
            console.print("[red]database connection provided.[/red]")
            return None

        if not logged_user:
            console.print("[red]You must be logged in to view your order.[/red]")
            return None

        cur = conn.cursor(dictionary=True)

        # Safely get user_id
        user_id = getattr(logged_user, "_customer_id", None)
        if not user_id and isinstance(logged_user, dict):
            user_id = logged_user.get("customer_id")
        if not user_id:
            console.print("[red]Could not determine user ID.[/red]")
            return None
        user_id = str(user_id)

        # Fetch user's shopping cart
        cur.execute("SELECT * FROM shopping_cart WHERE customer_id = %s", (user_id,))
        items = cur.fetchall()

        if not items:
            console.print("[yellow]Your shopping cart is empty.[/yellow]")
            return None

        # Display items in a table
        table = Table(title="Your Current Order", box=box.SIMPLE, header_style="bold cyan")
        table.add_column("No.", style="yellow")
        table.add_column("Product Name")
        table.add_column("Brand", style="cyan")
        table.add_column("Unit Price", justify="right", style="green")
        table.add_column("Quantity", justify="right", style="magenta")
        table.add_column("Subtotal", justify="right", style="bright_green")

        total = 0.0
        for idx, item in enumerate(items, start=1):
            subtotal = float(item["price"]) * int(item["quantity"])
            total += subtotal
            table.add_row(
                str(idx),
                item["product_name"],
                item["brand"],
                f"${item['price']:.2f}",
                str(item["quantity"]),
                f"${subtotal:.2f}"
            )

        # Add total row at the bottom
        table.add_row("", "", "", "[bold red]TOTAL[/bold red]", "", "", f"[bold green]${total:.2f}[/bold green]")

        console.print(Panel(table, title="[bold magenta]Order Summary[/bold magenta]", border_style="magenta"))

        return {"total": total, "items": items}

    except Exception as err:
        console.print(Panel(f"[red]Error showing order: {err}[/red]", title="Error", border_style="red"))
        return None


def show_my_profile(logged_user):
    console = Console()

    try:
        if not logged_user:
            console.print("[red]You must be logged in to view your profile.[/red]")
            return None

        # Define fields to display
        fields = [
            "customer_id", "first_name", "last_name", "age", "gender",
            "email", "phone", "address", "date_of_birth", "login_time"
        ]

        # Create a table for the profile
        profile_table = Table(title="My Profile", header_style="bold cyan", box=None)
        profile_table.add_column("Field", style="yellow")
        profile_table.add_column("Value", style="white")

        # Populate the table with user's data
        for field in fields:
            value = getattr(logged_user, field, "N/A")
            # Format datetime nicely if needed
            if isinstance(value, datetime):
                value = value.strftime("%Y-%m-%d %H:%M:%S")
            profile_table.add_row(field.replace("_", " ").title(), str(value))

        # Display table inside a panel
        console.print(Panel(profile_table, title="[bold green]Customer Profile[/bold green]", border_style="green"))

        return True

    except Exception as err:
        console.print(Panel(f"[red]Error displaying profile: {err}[/red]", title="Error", border_style="red"))
        return None


