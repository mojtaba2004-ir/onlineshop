                p.brand,

                p.product_type,

                p.colour


            FROM cart_item ci


            LEFT JOIN product p

            ON ci.product_id = p.product_id


            WHERE ci.cart_id IN ({placeholders})


            ORDER BY ci.cart_id DESC, ci.item_id ASC


            """,
            tuple(cart_ids)
        )


        cart_items = cur.fetchall()



        if not cart_items:

            console.print(
