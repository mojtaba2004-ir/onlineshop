        )


        table.add_column(
            "Product ID",
            style="green"
        )


        table.add_column(
            "Product"
        )


        table.add_column(
            "Brand"
        )


        table.add_column(
            "Type"
        )


        table.add_column(
            "Colour"
        )


        table.add_column(
            "Quantity"
        )


        table.add_column(
            "Price"
        )


        table.add_column(
            "Subtotal"
        )



        for item in cart_items:

            table.add_row(

                str(item["cart_id"]),

                str(item["item_id"]),

                str(item["product_id"]),

                item["product_name"] or "-",

                item["brand"] or "-",

                item["product_type"] or "-",

                item["colour"] or "-",

                str(item["quantity"]),

                f"${Decimal(item['price']):.2f}",

                f"${Decimal(item['subtotal']):.2f}"

            )



        console.print(
            Panel(
                table,
                title="Current Cart",
                border_style="blue"
            )
        )

        # =========================
        # ASK PRODUCT ID
        # =========================

        product_id_input = questionary.text(
            "Enter product ID to remove:"
        ).ask()



        if not product_id_input:

            return None



        # =========================
        # VALIDATE PRODUCT ID
        # =========================

        product_id = product_id_input.strip()


        if not product_id:

            console.print(
                Panel(
                    "[red]Invalid product ID.[/red]",
                    title="Error",
                    border_style="red"
                )
            )

            return None




        # =========================
        # FIND PRODUCT IN ALL CARTS
        # =========================

        placeholders = ",".join(
            ["%s"] * len(cart_ids)
        )



        cur.execute(
            f"""
            SELECT

                ci.item_id,

                ci.cart_id,

                ci.product_id,

                ci.quantity,

                ci.price,

                ci.subtotal,


                p.product_name,

                p.brand,

                p.product_type,

                p.colour


            FROM cart_item ci


            INNER JOIN product p

            ON ci.product_id = p.product_id



            WHERE ci.cart_id IN ({placeholders})


            AND ci.product_id=%s



            ORDER BY ci.item_id ASC


            LIMIT 1


            """,
            tuple(cart_ids) + (
                product_id,
            )
        )



        item = cur.fetchone()




        if not item:

            console.print(
                Panel(
                    "[yellow]Product not found in your carts.[/yellow]",
                    title="Remove Product",
                    border_style="yellow"
                )
            )

            return None





        # =========================
        # SHOW SELECTED PRODUCT
        # =========================

        console.print(
            Panel(
                f"""
Cart ID:
{item['cart_id']}


Cart Item ID:
{item['item_id']}


Product ID:
{item['product_id']}


Product:
{item['product_name']}


Brand:
{item['brand']}


Type:
{item['product_type']}


Colour:
{item['colour'] or "-"}


Quantity:
{item['quantity']}


Price:
${Decimal(item['price']):.2f}


Subtotal:
${Decimal(item['subtotal']):.2f}
                """,
                title="Selected Product",
                border_style="cyan"
            )
        )






        # =========================
        # CONFIRM REMOVE
        # =========================

        confirm = questionary.confirm(
            f"Remove {item['product_name']} from cart?"
        ).ask()



        if not confirm:

            console.print(
                Panel(
                    "[yellow]Removal cancelled.[/yellow]",
                    title="Cancelled",
                    border_style="yellow"
                )
            )

            return None






        # =========================
        # DELETE PRODUCT
        # =========================

        cur.execute(
            """
            DELETE FROM cart_item

            WHERE item_id=%s

            AND cart_id=%s

            """,
            (
                item["item_id"],

                item["cart_id"]
            )
        )



        if cur.rowcount == 0:

            raise Exception(
                "Product removal failed."
            )
                # =========================
        # RECALCULATE AFFECTED CART
        # =========================

        affected_cart_id = item["cart_id"]


        cur.execute(
            """
            SELECT

                COUNT(*) AS total_items,

                COALESCE(
                    SUM(subtotal),
                    0
                ) AS total_amount


            FROM cart_item


            WHERE cart_id=%s


            """,
            (
                affected_cart_id,
            )
        )


        totals = cur.fetchone()





        # =========================
        # UPDATE CART TOTALS
        # =========================

        cur.execute(
            """
            UPDATE shopping_cart

            SET

                total_items=%s,

                total_amount=%s


            WHERE cart_id=%s


            """,
            (
                totals["total_items"],

                totals["total_amount"],

                affected_cart_id
            )
        )





        # =========================
        # SAVE CHANGES
        # =========================

        conn.commit()





        console.print(
            Panel(
                f"""
[green]Product removed successfully![/green]


Removed Product:

{item['product_name']}


Cart ID:

{affected_cart_id}


Remaining Items:

{totals['total_items']}


Cart Total:

${Decimal(totals['total_amount']):.2f}
                """,
                title="Cart Updated",
                border_style="green"
            )
        )





        return {

            "status": "success",

            "removed_product":
                item["product_name"],

            "cart_id":
                affected_cart_id,

            "remaining_items":
                totals["total_items"],

            "total_amount":
                float(
                    totals["total_amount"]
                )

        }






    except Exception as error:


        if conn:

            conn.rollback()



        console.print(
            Panel(
                f"[red]{error}[/red]",
                title="Remove Product Error",
                border_style="red"
            )
        )


        return None






    finally:


        if cur:

            cur.close()



