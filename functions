def confirm_order(conn):
    try:
        cur = conn.cursor()

        order_id = questionary.text(
            "📦 Enter Order ID:"
        ).ask()

        if not order_id:
            return

        cur.execute("""
            SELECT order_id,
                   customer_id,
                   order_date,
                   total_price,
                   payment_status
            FROM orders
            WHERE order_id = %s
        """, (order_id,))

        order = cur.fetchone()

        if not order:
            console.print(
                Panel(
                    f"[red]❌ Order '{order_id}' not found.[/red]",
                    title="Order Search",
                    border_style="red"
                )
            )
            return

        order_table = Table(title="🧾 Order Information", box=box.SIMPLE)
        order_table.add_column("Field", style="cyan")
        order_table.add_column("Value", style="green")

        order_table.add_row("Order ID", order[0])
        order_table.add_row("Customer ID", order[1])
        order_table.add_row("Order Date", str(order[2]))
        order_table.add_row("Total Price", f"${order[3]}")
        order_table.add_row("Payment Status", order[4])

        console.print(
            Panel(
                order_table,
                border_style="blue"
            )
        )

        # Already confirmed?
        if order[4] == "paid-ready":
            console.print(
                Panel(
                    "[yellow]⚠ This order has already been confirmed.[/yellow]",
                    title="Information",
                    border_style="yellow"
                )
            )
            return

        # Only unpaid orders can be confirmed
        if order[4] != "unpaid":
            console.print(
                Panel(
                    f"[red]Order payment status is '{order[4]}'. Only unpaid orders can be confirmed.[/red]",
                    title="Cannot Confirm",
                    border_style="red"
                )
            )
            return

        confirm = questionary.confirm(
            "✅ Confirm this order?"
        ).ask()

        if not confirm:
            console.print(
                Panel(
                    "[yellow]Operation cancelled.[/yellow]",
                    title="Cancelled",
                    border_style="yellow"
                )
            )
            return

        cur.execute("""
            UPDATE orders
            SET payment_status = 'paid-ready to ship'
            WHERE order_id = %s
        """, (order_id,))

        conn.commit()

        console.print(
            Panel(
                f"[green]🎉 Order '{order_id}' confirmed successfully![/green]\n"
                "[cyan]Payment Status → paid-ready[/cyan]",
                title="Success",
                border_style="green"
            )
        )

        create_table_shipping_product(conn)

        ship = questionary.confirm(
            "🚚 Ship this order now?"
        ).ask()

        if ship:
            ship_product(conn, order_id)

        cur.close()

    except Exception as err:
        console.print(
            Panel(
                f"[red]{err}[/red]",
                title="Error",
                border_style="red"
            )
        )      


