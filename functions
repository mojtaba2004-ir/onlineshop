def view_seller_profile(conn, logged_seller):
    console = Console()
    try:
        if not conn:
            console.print("[red]No database connection provided.[/red]")
            return None

        if not logged_seller:
            console.print("[red]You must be logged in to view your profile.[/red]")
            return None

        # Safely get seller_id
        seller_id = getattr(logged_seller, "_seller_id", None)
        if seller_id is None and isinstance(logged_seller, dict):
            seller_id = logged_seller.get("seller_id")
        if seller_id in (None, "", 0):
            console.print("[red]Could not determine seller ID.[/red]")
            return None
        seller_id = str(seller_id)

        cursor = conn.cursor(dictionary=True)
        query = """
            SELECT seller_id, first_name, last_name, age, gender, phone,
                   address, email, store_name, plaque_store, business_license, login_time
            FROM seller
            WHERE seller_id = %s
        """
        cursor.execute(query, (seller_id,))
        result = cursor.fetchone()
        cursor.close()

        if not result:
            console.print(Panel("[red]Seller not found in the database.[/red]", title="Error", border_style="red"))
            return

        table = Table(title=f"{result['first_name']} {result['last_name']}'s Profile")
        table.add_column("Field", style="cyan", no_wrap=True)
        table.add_column("Value", style="magenta")

        for label, key in [
            ("Seller ID", "seller_id"),
            ("First Name", "first_name"),
            ("Last Name", "last_name"),
            ("Age", "age"),
            ("Gender", "gender"),
            ("Phone", "phone"),
            ("Address", "address"),
            ("Email", "email"),
            ("Store Name", "store_name"),
            ("Plaque Store", "plaque_store"),
            ("Business License", "business_license"),
            ("Login Time", "login_time")
        ]:
            table.add_row(label, str(result[key]))

        console.print(Panel(table, title="[bold green]Seller Profile[/bold green]", border_style="green"))

    except mysql.connector.Error as e:
        console.print(Panel(f"[red]Database error: {e}[/red]", title="Error", border_style="red"))
    except Exception as e:
        console.print(Panel(f"[red]Unexpected error: {e}[/red]", title="Error", border_style="red"))


def edit_seller_profile(conn, logged_seller):
    try:
        if not conn:
            console.print("[red]No database connection provided.[/red]")
            return False

        if not logged_seller:
            console.print("[red]You must be logged in to edit your profile.[/red]")
            return False

        # Get seller_id safely from property
        seller_id = getattr(logged_seller, "seller_id", None)
        if seller_id in (None, "", 0):
            console.print("[red]Could not determine seller ID.[/red]")
            return False

        # Fields that can be updated, mapped to property names
        allowed_fields = {
            "first_name": "First Name",
            "last_name": "Last Name",
            "age": "Age",
            "gender": "Gender",
            "phone": "Phone",
            "address": "Address",
            "email": "Email",
            "store_name": "Store Name",
            "plaque_store": "Plaque Store",
            "business_license": "Business License"
        }

        # Collect new values from the user
        filtered_updates = {}
        for field, prompt_text in allowed_fields.items():
            # Use the property to get current value
            current_value = getattr(logged_seller, field, "")
            new_value = input(f"{prompt_text} [{current_value}]: ").strip()
            if new_value and new_value != str(current_value):
                filtered_updates[field] = new_value

        if not filtered_updates:
            console.print("[yellow]⚠️ No changes made to the profile.[/yellow]")
            return False


        set_clause = ", ".join(f"{field} = %s" for field in filtered_updates)
        values = list(filtered_updates.values())
        values.append(seller_id)  # For WHERE clause

        query = f"UPDATE seller SET {set_clause} WHERE seller_id = %s"

        cursor = conn.cursor()
        cursor.execute(query, tuple(values))
        conn.commit()
        cursor.close()

        console.print(Panel("[green]Profile updated successfully![/green]", title="Success", border_style="green"))

