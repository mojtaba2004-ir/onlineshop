        customer_id = str(logged_user.customer_id).strip().replace(" ", "")

    elif isinstance(logged_user, dict):
        customer_id = str(logged_user["customer_id"]).strip()

    else:
        console.print("[red]Invalid logged user.[/red]")
        return None, []

    # Verify customer exists
    cur.execute(
        "SELECT customer_id FROM customer WHERE customer_id=%s",
        (customer_id,)
    )

    if cur.fetchone() is None:
        console.print(
            f"[red]Customer '{customer_id}' not found.[/red]"
        )
        return None, []

    # Get customer's cart
    cur.execute("""
        SELECT cart_id
        FROM shopping_cart
        WHERE customer_id=%s
    """, (customer_id,))

    cart = cur.fetchone()

    if cart is None:
        return customer_id, []

    cart_id = cart["cart_id"]

    # Get cart items
    cur.execute("""
        SELECT
            ci.product_id,
            ci.quantity,
            ci.price,
            p.product_name,
            p.brand
        FROM cart_item ci
        JOIN product p
            ON ci.product_id = p.product_id
        WHERE ci.cart_id = %s
    """, (cart_id,))

    items = cur.fetchall()

    return customer_id, items


def select_checkout_product(conn, logged_user):

    cur = None

    try:

        cur = conn.cursor(dictionary=True, buffered=True)


        # =========================
        # GET CUSTOMER ID
        # =========================

        if hasattr(logged_user, "customer_id"):

            customer_id = logged_user.customer_id


        elif isinstance(logged_user, dict):

            customer_id = logged_user.get("customer_id")


        else:

            console.print(
                "[red]Invalid user.[/red]"
            )

            return None



        # =========================
        # GET CARTS
        # =========================

        cur.execute(
            """
            SELECT cart_id

            FROM shopping_cart

            WHERE customer_id=%s

            ORDER BY cart_id DESC

            """,
            (
                customer_id,
            )
        )


        carts = cur.fetchall()



        if not carts:

            console.print(
                "[yellow]No cart found.[/yellow]"
            )

            return None



        cart_ids = [
            cart["cart_id"]
            for cart in carts
        ]



        placeholders = ",".join(
            ["%s"] * len(cart_ids)
        )



        # =========================
        # GET PRODUCTS
        # =========================

        cur.execute(
            f"""
            SELECT

                ci.item_id,

                ci.cart_id,

                ci.product_id,

                ci.quantity,

                ci.price,

                ci.subtotal,

                p.product_name,

                p.brand


            FROM cart_item ci


            JOIN product p

            ON ci.product_id=p.product_id


            WHERE ci.cart_id IN ({placeholders})


            ORDER BY ci.cart_id DESC


            """,
