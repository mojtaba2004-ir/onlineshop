    table.add_column("Qty", justify="right")
    table.add_column("Subtotal", justify="right")

    total = Decimal("0.00")

    for i, item in enumerate(items, 1):

        price = Decimal(item["price"] or 0)
        quantity = int(item["quantity"])

        subtotal = price * quantity
        total += subtotal

        table.add_row(
            str(i),
            item["product_name"],
