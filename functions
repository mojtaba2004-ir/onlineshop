def update_product_inventory(conn, items):

    try:
        cur = conn.cursor()

        for item in items:

            cur.execute("""
                UPDATE product
                SET
                    quantity = quantity - %s,
                    purchased_quantity = purchased_quantity + %s
                WHERE product_id = %s
                AND quantity >= %s
            """, (
                item["quantity"],
                item["quantity"],
                item["product_id"],
                item["quantity"]
            ))

            if cur.rowcount == 0:
                raise Exception(
                    f"Not enough product for Product ID: {item['product_id']}"
                )

        conn.commit()

        success = Table.grid()
        success.add_column()
        success.add_row("[green]✔ Product inventory updated successfully.[/green]")

        console.print(
            Panel(
                success,
                title="Inventory Updated",
                border_style="green"
            )
        )

        return True

    except Exception as err:

        conn.rollback()

        error = Table.grid()
        error.add_column()
        error.add_row(f"[red]{err}[/red]")

        console.print(
            Panel(
                error,
                title="Inventory Error",
                border_style="red"
            )
        )

        return False

    finally:
        cur.close()


