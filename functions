        cursor = conn.cursor()

        cursor.execute("SHOW DATABASES")
        dbs = [db[0] for db in cursor.fetchall()]

        message_table = Table.grid()
        message_table.add_column()

        if db_name in dbs:
            message_table.add_row(
                f"[yellow]Database '{db_name}' already exists.[/yellow]"
            )
        else:
            cursor.execute(f"CREATE DATABASE `{db_name}`")
            message_table.add_row(
                f"[green]Database '{db_name}' created successfully.[/green]"
            )

        conn.commit()
        cursor.close()

        console.print(
