def send_email_to_sellers(conn, customer_id):

    import smtplib
    from email.message import EmailMessage
    from decimal import Decimal
    from collections import defaultdict

    EMAIL_ADDRESS = "secmailmal@gmail.com"
    EMAIL_PASSWORD = "lfbkiywufffanena"

    cur = conn.cursor(dictionary=True)

    try:

        # =========================
        # FETCH ORDER ITEMS
        # =========================
        cur.execute("""
            SELECT
                p.product_name,
                p.brand,
                p.price,
                ci.quantity,
                p.seller_id,
                s.email AS seller_email,
                s.store_name,
                sc.cart_id
            FROM cart_item ci
            JOIN product p ON ci.product_id = p.product_id
            JOIN seller s ON p.seller_id = s.seller_id
            JOIN shopping_cart sc ON ci.cart_id = sc.cart_id
            WHERE sc.customer_id = %s
        """, (customer_id,))

        items = cur.fetchall()

        if not items:
            title = Text("no items found in cart.", justify="center", style="bold red")

            console.print(
                Panel(title, border_style="red", width=60)
            )
            return False

        # =========================
        # GROUP BY SELLER
        # =========================
        sellers = defaultdict(list)

        for item in items:
            sellers[item["seller_email"]].append(item)

        # =========================
        # EMAIL SERVER
        # =========================
        with smtplib.SMTP("smtp.gmail.com", 587) as server:
            server.starttls()
            server.login(EMAIL_ADDRESS, EMAIL_PASSWORD)

            # =========================
            # SEND PER SELLER email
            # =========================
            for seller_email, products in sellers.items():

                seller_name = products[0].get("store_name", "Seller")

                message_lines = []
                seller_total = Decimal("0.00")

                for p in products:

                    price = Decimal(str(p["price"]))
                    qty = int(p["quantity"])
                    subtotal = price * qty
                    seller_total += subtotal

                    message_lines.append(
                        f"• {p['product_name']} ({p['brand']})\n"
                        f"  Qty: {qty}\n"
                        f"  Unit Price: ${price:.2f}\n"
                        f"  Subtotal: ${subtotal:.2f}\n"
                    )

                # =========================
                # EMAIL BODY
                # =========================
                email_body = (
                    f"NEW ORDER NOTIFICATION\n"
                    f"{'-'*40}\n\n"
                    f"Dear {seller_name},\n\n"
                    f"a customer has purchased a product.\n\n"
                    f"ORDER DETAILS:\n"
                    f"{'-'*40}\n"
                    f"{chr(10).join(message_lines)}\n"
                    f"{'-'*40}\n\n"
                    f"TOTAL payment amount: ${seller_total:.2f}\n\n"
                    f"Please confirm this order as soon as possible.\n\n"
                    f"Thank you,\n"
                )

                # =========================
                # EMAIL OBJECT
                # =========================
                msg = EmailMessage()
                msg["Subject"] = "🛒 NEW ORDER RECEIVED"
                msg["From"] = EMAIL_ADDRESS
                msg["To"] = seller_email
                msg.set_content(email_body)

                server.send_message(msg)

                console.print(
                    Panel(
                        f"[green]EMAIL SENT TO {seller_email}[/green]",
                        title="Seller Notification",
                        border_style="green"
                    )
                )

        return True

    except Exception as e:
        console.print(
            Panel(
                f"[red]Failed to send email: {e}[/red]",
                title="Email Error",
                border_style="red"
            )
        )
        return False

    finally:
        cur.close()


