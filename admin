    admin_file = "admin_data.json"

    # If no admin exists → signup
    if not os.path.exists(admin_file) or os.stat(admin_file).st_size == 0:
        
        title = Text("no admin detected, please sign up.", justify="center", style="bold red")

        console.print(
            Panel(title, border_style="red", width=40)
        )
        
        admin_signup()
    else:
        console.print(Panel("[cyan]Admin already exists. Please log in.[/cyan]", expand=False))

    # Perform login once
    return admin_login()
